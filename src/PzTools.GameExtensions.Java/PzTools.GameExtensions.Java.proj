<Project DefaultTargets="Build">
  <Import Project="..\..\build\SaveBridge.props" />
  <PropertyGroup>
    <ExtensionOutput>$(BridgeOutputPath)\extensions</ExtensionOutput>
    <Classes>$(MSBuildProjectDirectory)\obj\$(Configuration)\classes</Classes>
  </PropertyGroup>
  <ItemGroup>
    <JavaSource Include="$(MSBuildProjectDirectory)\java\**\*.java" />
  </ItemGroup>
  <!-- A deleted source changes no timestamp; the list does, so its classes are not left in the JAR. -->
  <Target Name="ListSources">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\obj\$(Configuration)\java-sources.txt" Lines="@(JavaSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="Build" DependsOnTargets="ValidateBridgeToolchain;ListSources"
          Inputs="@(JavaSource);$(MSBuildProjectDirectory)\obj\$(Configuration)\java-sources.txt;$(MSBuildProjectFullPath);$(BridgeJdkPath)\release"
          Outputs="$(ExtensionOutput)\pztools-extension-runtime.jar">
    <RemoveDir Directories="$(Classes)" />
    <MakeDir Directories="$(Classes);$(ExtensionOutput)" />
    <Exec Command="&quot;$(BridgeJdkPath)\bin\javac.exe&quot; --release 25 -encoding UTF-8 -d &quot;$(Classes)&quot; @(JavaSource->'&quot;%(FullPath)&quot;', ' ')" />
    <WriteLinesToFile File="$(Classes)\module.mf" Lines="Manifest-Version: 1.0;PzTools-Extension-Api: 3" Overwrite="true" />
    <Exec Command="&quot;$(BridgeJdkPath)\bin\jar.exe&quot; --create --date=2020-01-01T00:00:00Z --manifest &quot;$(Classes)\module.mf&quot; --file &quot;$(ExtensionOutput)\pztools-extension-runtime.jar&quot; -C &quot;$(Classes)&quot; pztools" />
  </Target>
</Project>
