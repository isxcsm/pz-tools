<UserControl
    x:Class="PzTools.App.ProfilerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PzTools.App"
    SizeChanged="ProfilerPage_SizeChanged" KeyDown="Page_KeyDown">
  <UserControl.Resources>
    <!-- The frame graph's colours, chosen per theme for contrast on the card: the system's accent can be any colour,
         and its caution colour was a glaring yellow on dark and a dull brown on light. -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ProfileFrameBrush" Color="#3B82F6" />
          <SolidColorBrush x:Key="ProfileSlowFrameBrush" Color="#EA580C" />
          <SolidColorBrush x:Key="ProfileHighlightBrush" Color="#1D4ED8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ProfileFrameBrush" Color="#60A5FA" />
          <SolidColorBrush x:Key="ProfileSlowFrameBrush" Color="#FB923C" />
          <SolidColorBrush x:Key="ProfileHighlightBrush" Color="#BFDBFE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="ProfileFrameBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="ProfileSlowFrameBrush" Color="{ThemeResource SystemColorHotlightColor}" />
          <SolidColorBrush x:Key="ProfileHighlightBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- Theme colours for what code draws, resolved here in the page's own theme: the app's resources follow Windows'
         theme, not the one chosen in PZ Tools, and gave light colours on a dark page. Never shown. -->
    <StackPanel x:Name="ThemeProbes" Visibility="Collapsed">
      <Border x:Name="SolidBaseProbe" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
      <Border x:Name="CardStrokeProbe" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Border x:Name="SecondaryTextProbe" Background="{ThemeResource TextFillColorSecondaryBrush}" />
      <Border x:Name="PrimaryTextProbe" Background="{ThemeResource TextFillColorPrimaryBrush}" />
      <Border x:Name="SuccessProbe" Background="{ThemeResource SystemFillColorSuccessBrush}" />
      <Border x:Name="CriticalProbe" Background="{ThemeResource SystemFillColorCriticalBrush}" />
      <Border x:Name="AccentTextProbe" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </StackPanel>

    <!-- Two lines. The title's: making a recording, at its right. The next: the recording shown, and what is done to
         it. A narrow window moves the first line's tools below the title. -->
    <Grid x:Name="HeaderGrid" ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" MinHeight="{StaticResource PageHeaderHeight}" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- The tools sit on the title's baseline: their text lines up with the bottom of the title's letters,
           instead of their boxes being centred on the taller title. -->
      <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Top"
                 Margin="0,3,0,0" AutomationProperties.HeadingLevel="Level1" />
      <StackPanel x:Name="CaptureBar" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                  VerticalAlignment="Top" Margin="0,9,0,0">
        <!-- Saves the last minutes the game keeps (Settings > Performance), right after a stutter; while they are not
             kept, it says so and leads to that setting. A disabled button shows no tooltip; its holder carries it,
             which says why when it cannot. -->
        <Grid x:Name="SaveLastHost" Background="Transparent">
          <Button x:Name="SaveLastButton" Click="SaveLastButton_Click" AutomationProperties.AutomationId="ProfileSaveLastButton">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontSize="14" Glyph="&#xE81C;" />
              <TextBlock x:Name="SaveLastText" />
              <FontIcon x:Name="SaveLastLeads" FontSize="11" Glyph="&#xE72A;" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
          </Button>
        </Grid>
        <!-- Records; its arrow chooses the mode, said on the button only when it is Detailed. Its holder says why
             recording cannot start. -->
        <Grid x:Name="RecordHost" Background="Transparent">
          <SplitButton x:Name="RecordButton" MinWidth="120" Click="RecordButton_Click"
                       AutomationProperties.AutomationId="ProfileRecordButton">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon x:Name="RecordIcon" FontSize="14" Glyph="&#xE7C8;" />
              <TextBlock x:Name="RecordText" />
            </StackPanel>
            <SplitButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <RadioMenuFlyoutItem x:Name="ModeGeneralItem" GroupName="ProfileMode" Click="ModeItem_Click" />
                <RadioMenuFlyoutItem x:Name="ModeDetailedItem" GroupName="ProfileMode" Click="ModeItem_Click" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
        </Grid>
      </StackPanel>
      <!-- The recording shown, and close beside it what is done to it: rename, delete; then compare, and the rest. -->
      <Grid x:Name="RecordingBar" Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="2" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="560" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="RecordingList" MinWidth="200" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  SelectionChanged="RecordingList_SelectionChanged"
                  AutomationProperties.AutomationId="ProfileRecordingList" />
        <!-- In the list's place while the selected recording is renamed; its own X empties it. -->
        <TextBox x:Name="RenameBox" MinWidth="200" VerticalAlignment="Center" Visibility="Collapsed"
                 KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" AutomationProperties.AutomationId="ProfileRenameBox" />
        <Button x:Name="RenameButton" Grid.Column="1" Width="36" Height="32" Padding="0" VerticalAlignment="Center"
                Style="{StaticResource SubtleButtonStyle}" Click="RenameButton_Click" IsEnabled="False"
                AutomationProperties.AutomationId="ProfileRenameButton">
          <FontIcon Glyph="&#xE70F;" FontSize="16" />
        </Button>
        <!-- Asks before deleting. -->
        <Button x:Name="DeleteButton" Grid.Column="2" Width="36" Height="32" Padding="0" VerticalAlignment="Center"
                Style="{StaticResource SubtleButtonStyle}" Click="DeleteItem_Click" IsEnabled="False"
                AutomationProperties.AutomationId="ProfileDeleteButton">
          <FontIcon Glyph="&#xE74D;" FontSize="16" />
        </Button>
        <Rectangle Grid.Column="3" Width="1" Height="20" Margin="8,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <!-- Another recording to set the shown one against; the menu lists them when it opens. -->
        <DropDownButton x:Name="CompareButton" Grid.Column="4" VerticalAlignment="Center" IsEnabled="False"
                        AutomationProperties.AutomationId="ProfileCompareButton">
          <!-- While comparing, it names the recording compared with, in the accent colour; the ✕ beside it ends it. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon x:Name="CompareIcon" Glyph="&#xE8AB;" FontSize="14" />
            <!-- In the icon's place while a recording chosen takes a while to load. -->
            <ProgressRing x:Name="CompareProgress" Width="14" Height="14" MinWidth="14" MinHeight="14" IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="CompareText" MaxWidth="320" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
          <DropDownButton.Flyout>
            <MenuFlyout x:Name="CompareMenu" Placement="BottomEdgeAlignedLeft" Opening="CompareMenu_Opening" />
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button x:Name="CompareClearButton" Grid.Column="5" Width="32" Height="32" Padding="0" Margin="2,0,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                Style="{StaticResource SubtleButtonStyle}" Click="CompareClearButton_Click"
                AutomationProperties.AutomationId="ProfileCompareClearButton">
          <FontIcon Glyph="&#xE711;" FontSize="12" />
        </Button>
        <Button x:Name="MoreButton" Grid.Column="6" AutomationProperties.AutomationId="ProfileMoreButton" Width="36" Height="32" Padding="0" VerticalAlignment="Center"
                Style="{StaticResource SubtleButtonStyle}">
          <FontIcon Glyph="&#xE712;" FontSize="16" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="MoreMenu_Opening">
              <MenuFlyoutItem x:Name="ImportItem" Click="ImportItem_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem x:Name="SaveAsItem" Click="SaveAsItem_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <!-- The selected range as a recording of its own: to compare with, or to pass on. -->
              <MenuFlyoutItem x:Name="SaveRangeItem" Click="SaveRangeItem_Click" AutomationProperties.AutomationId="ProfileSaveRangeItem">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A8;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem x:Name="OpenFolderItem" Click="OpenFolderItem_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Grid>
    <!-- What the recording is doing; only while it records. -->
    <StackPanel x:Name="StatusPanel" Grid.Row="1" Spacing="2" Visibility="Collapsed" Margin="0,4,0,4">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
      <TextBlock x:Name="StatusNote" TextWrapping="Wrap" Visibility="Collapsed"
                 Style="{StaticResource SecondaryTextStyle}" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>


      <!-- The graph stays in place while the results below scroll: it chooses what they show. -->
      <StackPanel x:Name="ChartPanel" Spacing="4" Visibility="Collapsed">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!-- The range the results describe; while the pointer is over the graph, the frame under it.
               Names are muted and numbers are not, so the eye finds the numbers first. -->
          <!-- A selection shows as a chip with its ✕, like an active filter: pressing it (or Escape) goes back to the
               whole recording. -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SelectionChip" Visibility="Collapsed" Padding="10,3,8,4" MinHeight="0" CornerRadius="12"
                    VerticalAlignment="Center" Click="SelectionChip_Click" AutomationProperties.AutomationId="ProfileSelectionChip"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <FontIcon Glyph="&#xE711;" FontSize="10" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="ChartInfo" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </Grid>
          <!-- Whose samples the results count, the game's thread or all of them: a choice for the whole analysis,
               both tabs, so it stands with the range the analysis is of. -->
          <ComboBox x:Name="ThreadBox" Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                    SelectionChanged="ThreadBox_SelectionChanged" AutomationProperties.AutomationId="ProfileThreadBox" />
          <Button x:Name="ZoomSelectionButton" Grid.Column="2" Click="ZoomSelectionButton_Click" IsEnabled="False"
                  Style="{StaticResource SubtleButtonStyle}" />
          <Button x:Name="ZoomAllButton" Grid.Column="3" Click="ZoomAllButton_Click"
                  Style="{StaticResource SubtleButtonStyle}" />
          <Border x:Name="ChartHelp" Grid.Column="4" Background="Transparent" Padding="6" VerticalAlignment="Center">
            <FontIcon x:Name="ChartHelpIcon" Glyph="&#xE9CE;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Border>
        </Grid>
        <!-- The frame graph. Bars are frame times; the tallest frame of each slice is kept, so spikes never vanish when zoomed out. -->
        <Border x:Name="ChartBorder" Height="140" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <Grid x:Name="ChartSurface" Background="Transparent" Margin="44,8,8,20"
                SizeChanged="ChartSurface_SizeChanged"
                PointerPressed="Chart_PointerPressed" PointerMoved="Chart_PointerMoved"
                PointerReleased="Chart_PointerReleased" PointerCanceled="Chart_PointerCanceled"
                PointerCaptureLost="Chart_PointerCanceled" PointerExited="Chart_PointerExited"
                PointerWheelChanged="Chart_PointerWheelChanged" DoubleTapped="Chart_DoubleTapped">
            <Canvas x:Name="GridCanvas" IsHitTestVisible="False" />
            <Path x:Name="BarsPath" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Fill="{ThemeResource ProfileFrameBrush}" />
            <Path x:Name="SlowBarsPath" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Fill="{ThemeResource ProfileSlowFrameBrush}" />
            <!-- The highlighted owner's part of each bar, over the bars faded behind it. -->
            <Path x:Name="HighlightPath" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Fill="{ThemeResource ProfileHighlightBrush}" />
            <!-- The 60 and 30 FPS lines, over the bars: a slow recording's bars would otherwise hide them. -->
            <Canvas x:Name="ReferenceCanvas" IsHitTestVisible="False" />
            <Canvas IsHitTestVisible="False">
              <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed" Opacity="0.28"
                         Fill="{ThemeResource TextFillColorPrimaryBrush}" />
              <Rectangle x:Name="HoverLine" Width="1" Visibility="Collapsed" Opacity="0.5"
                         Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            </Canvas>
          </Grid>
        </Border>
        <ScrollBar x:Name="ViewScroll" Orientation="Horizontal" IndicatorMode="MouseIndicator"
                   Visibility="Collapsed" Scroll="ViewScroll_Scroll" />
        <!-- Collections and memory. The button opens the heap and video memory graphs under the frames; their
             figures stand on this line in their lines' colours, so they also name the lines. -->
        <Grid x:Name="MemoryHeader" Visibility="Collapsed" ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="MemoryToggle" Click="MemoryToggle_Click" Padding="6,2"
                  Style="{StaticResource SubtleButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon x:Name="MemoryChevron" Glyph="&#xE76C;" FontSize="10" />
              <TextBlock x:Name="MemoryToggleText" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock x:Name="HeapValue" Tapped="MemoryFigure_Tapped" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            <TextBlock x:Name="VideoValue" Tapped="MemoryFigure_Tapped" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <!-- The game ran short of memory in this recording: said here, beside the heap it is about, with the way to
                 give it more; or, once the game has been given more since, said as what was, with what it has now. -->
            <StackPanel x:Name="MemoryShortPanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed" VerticalAlignment="Center">
              <FontIcon x:Name="MemoryShortIcon" Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
              <FontIcon x:Name="MemoryRaisedIcon" Glyph="&#xE946;" FontSize="12" Visibility="Collapsed"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="MemoryShortText" FontSize="12" VerticalAlignment="Center" />
              <HyperlinkButton x:Name="MemoryShortButton" AutomationProperties.AutomationId="ProfileMemorySettingButton" Padding="6,1" FontSize="12" Click="MemoryShortButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock x:Name="MemoryShortButtonText" />
                  <FontIcon Glyph="&#xE72A;" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
              </HyperlinkButton>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="CollectionValue" Tapped="MemoryFigure_Tapped" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <!-- Heap above, video memory below, each on its own scale; the same time axis, zoom, selection and
             pointer line as the frame graph, whose margins it shares so the two line up. -->
        <Border x:Name="MemoryBorder" Visibility="Collapsed" Height="96" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <Grid x:Name="MemorySurface" Background="Transparent" Margin="44,6,8,6"
                SizeChanged="MemorySurface_SizeChanged"
                PointerPressed="Chart_PointerPressed" PointerMoved="Chart_PointerMoved"
                PointerReleased="Chart_PointerReleased" PointerCanceled="Chart_PointerCanceled"
                PointerCaptureLost="Chart_PointerCanceled" PointerExited="Chart_PointerExited"
                PointerWheelChanged="Chart_PointerWheelChanged" DoubleTapped="Chart_DoubleTapped">
            <Canvas x:Name="MemoryCanvas" IsHitTestVisible="False" />
            <Canvas IsHitTestVisible="False">
              <Rectangle x:Name="MemorySelection" Visibility="Collapsed" Opacity="0.28"
                         Fill="{ThemeResource TextFillColorPrimaryBrush}" />
              <Rectangle x:Name="MemoryHoverLine" Width="1" Visibility="Collapsed" Opacity="0.5"
                         Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            </Canvas>
            <!-- The rows' names, on top; only the names take the pointer, for their tips. -->
            <Canvas x:Name="MemoryNames" />
          </Grid>
        </Border>
        <!-- Drag to give the graph or the results more room. -->
        <local:ResizeGrip x:Name="ChartGrip" Height="10" Background="Transparent"
                          PointerPressed="ChartGrip_PointerPressed" PointerMoved="ChartGrip_PointerMoved"
                          PointerReleased="ChartGrip_PointerReleased" PointerCaptureLost="ChartGrip_PointerReleased">
          <Rectangle Width="36" Height="3" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="{ThemeResource TextFillColorTertiaryBrush}" />
        </local:ResizeGrip>
      </StackPanel>

      <StackPanel Grid.Row="1">
        <InfoBar x:Name="FewSamplesInfo" Margin="0,4,0,0" IsOpen="False" IsClosable="False" Severity="Warning" />
        <!-- Where the range's time went on the game thread: its scripts (with the game functions they called), the
             game's own code, collections stopping the game, and waiting (for the next frame, or stuck on a file or another thread). One look tells whether a stutter
             was the scripts, the game or the memory, without adding up the tabs, which count the same time two ways. -->
        <Grid x:Name="TimeBreakdownPanel" Margin="0,10,0,2" RowSpacing="6" Visibility="Collapsed"
              AutomationProperties.AutomationId="ProfileTimeBreakdown">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="TimeBreakdownBar" Height="6" CornerRadius="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="SelectedColumn" Width="0" />
              <ColumnDefinition x:Name="ScriptsColumn" Width="0" />
              <ColumnDefinition x:Name="GameColumn" Width="0" />
              <ColumnDefinition x:Name="CollectionsColumn" Width="0" />
              <ColumnDefinition x:Name="SpareColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The chosen mod's part of the scripts, solid; the other scripts beside it, lighter. -->
            <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Rectangle x:Name="OtherScriptsBar" Grid.Column="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Rectangle Grid.Column="2" Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            <Rectangle Grid.Column="3" Fill="{ThemeResource SystemFillColorCautionBrush}" />
            <Rectangle Grid.Column="4" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <TextBlock x:Name="TimeBreakdownTitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="SelectedLegend" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
              <TextBlock x:Name="SelectedLabel" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="SelectedValue" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse x:Name="ScriptsDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
              <TextBlock x:Name="ScriptsLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="ScriptsValue" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
              <TextBlock x:Name="GameLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="GameValue" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorCautionBrush}" />
              <TextBlock x:Name="CollectionsLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="CollectionsValue" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
              <TextBlock x:Name="SpareLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="SpareValue" FontSize="12" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- Scripts or game code, one at a time. Who took the time on the left, what exactly on the right:
           pick an owner, read its functions. The chosen owner's name and share head the table from outside it. -->
      <Grid x:Name="ResultsGrid" Grid.Row="2" Margin="0,4,0,0" ColumnSpacing="12" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="GroupColumn" Width="300" />
          <ColumnDefinition x:Name="DetailColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="GroupRow" Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="DetailRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid>
          <SelectorBar x:Name="ResultTabs" SelectionChanged="ResultTabs_SelectionChanged">
            <SelectorBarItem x:Name="LuaTab" IsSelected="True" />
            <SelectorBarItem x:Name="JavaTab" AutomationProperties.AutomationId="ProfileJavaTab" />
            <!-- Only for recordings whose Lua samples carry allocations. -->
            <SelectorBarItem x:Name="AllocationTab" Visibility="Collapsed" AutomationProperties.AutomationId="ProfileAllocationTab" />
          </SelectorBar>
          <Canvas x:Name="TabSelectionLayer" IsHitTestVisible="False">
            <Border x:Name="TabSelectionBar" Width="16" Height="3" CornerRadius="1.5" Visibility="Collapsed"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
          </Canvas>
        </Grid>
        <Border x:Name="GroupCard" Grid.Row="1" Margin="0,8,0,0" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- How the list's numbers relate to the other tab's, under the list where it is read: the scripts' include
                 the game functions they called, which the game code's tab counts under the game. Said on the page, not
                 only one hover away: read the other way, the two tabs seemed to blame the wrong mod. -->
            <Border x:Name="GroupNoteArea" Grid.Row="2" Padding="24,8,16,10" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
              <TextBlock x:Name="GroupNote" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <!-- Column headings like the table beside: what the list holds and what its number is.
                 The number's meaning differs by tab, so it is explained one hover away. Insets match the rows'. -->
            <Border Padding="24,12,16,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GroupNameHeading" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <StackPanel x:Name="GroupShareHeading" Grid.Column="1" Orientation="Horizontal" Spacing="4" Background="Transparent">
                  <TextBlock x:Name="GroupShareText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                  <FontIcon Glyph="&#xE946;" FontSize="12" VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <!-- The scripts' share of the range, all mods together: what the rows below divide among themselves.
                       In the normal text colour, so the number reads as a value, not as part of the heading. -->
                  <TextBlock x:Name="GroupShareTotal" Margin="4,0,0,0" TextWrapping="NoWrap" />
                  <!-- Compared, how far the scripts' part moved, red for more, green for less, like the rows'. -->
                  <TextBlock x:Name="GroupShareDelta" TextWrapping="NoWrap" Visibility="Collapsed" FontSize="12"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
            <ListView x:Name="GroupList" Grid.Row="1" Padding="4" SelectionMode="Single" ItemContainerStyle="{StaticResource ContentListItemStyle}"
                      SelectionChanged="GroupList_SelectionChanged" IsItemClickEnabled="True" ItemClick="GroupList_ItemClick"
                      AutomationProperties.AutomationId="ProfileGroupList">
              <ListView.ItemContainerTransitions>
                <TransitionCollection />
              </ListView.ItemContainerTransitions>
            </ListView>
            <!-- The same moving accent bar as the save, backup and log lists. -->
            <Canvas x:Name="GroupSelectionLayer" Grid.Row="1" IsHitTestVisible="False">
              <Border x:Name="GroupSelectionBar" Width="3" Height="16" Canvas.Left="10"
                      CornerRadius="2" Visibility="Collapsed"
                      Background="{ThemeResource AccentFillColorDefaultBrush}" />
            </Canvas>
          </Grid>
        </Border>
        <!-- The chosen owner's title and the table's tools in one line, level with the tabs and outside the card, so
             the two cards start level: the owner's name, its samples, then search, the call tree and the copy. Search
             narrows the rows to names and files holding the text (a tree keeps the paths to them); its box opens where
             its button is (or by Ctrl+F) and the name gives way to it. The call tree shows the paths that led to each
             function; the copy puts what the page shows on the clipboard. Stacked, the line comes just above its card. -->
        <Grid x:Name="DetailTitle" Grid.Column="1" Padding="12,0,0,0" ColumnSpacing="8" VerticalAlignment="Center"
              KeyboardAcceleratorPlacementMode="Hidden" SizeChanged="DetailTitle_SizeChanged">
          <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="SearchAccelerator_Invoked" />
          </Grid.KeyboardAccelerators>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DetailName" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <Button x:Name="SearchButton" Grid.Column="1" Width="36" Height="32" Padding="0" VerticalAlignment="Center"
                  Style="{StaticResource SubtleButtonStyle}" Click="SearchButton_Click"
                  AutomationProperties.AutomationId="ProfileSearchButton">
            <FontIcon Glyph="&#xE721;" FontSize="16" />
          </Button>
          <AutoSuggestBox x:Name="DetailSearch" Grid.Column="1" Width="260" QueryIcon="Find" VerticalAlignment="Center"
                          Visibility="Collapsed" TextChanged="DetailSearch_TextChanged" LostFocus="DetailSearch_LostFocus"
                          AutomationProperties.AutomationId="ProfileDetailSearch" />
          <ToggleSwitch x:Name="CallTreeToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Visibility="Collapsed"
                        Toggled="CallTreeToggle_Toggled" AutomationProperties.AutomationId="ProfileCallTreeToggle" />
          <!-- With its name, not a bare icon in the corner: copying what the page shows is how results get shared. -->
          <Button x:Name="CopyResultsButton" Grid.Column="3" Height="32" Padding="8,0" VerticalAlignment="Center"
                  Style="{StaticResource SubtleButtonStyle}" Click="CopyResultsButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE8C8;" FontSize="16" />
              <TextBlock x:Name="CopyResultsText" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Rectangle x:Name="SamplesDivider" Grid.Column="4" Width="1" Height="20" VerticalAlignment="Center"
                     Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <!-- The owner's samples out of the tab's, last on the line as before, in the line's text size. The divider has
               16 on each side (the copy button's own 8 plus the spacing on its left), and the number ends where the
               table's sample column does below it (the card's border and the header's 16). -->
          <TextBlock x:Name="DetailSamples" Grid.Column="5" Margin="8,0,17,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
        </Grid>
        <!-- The chosen owner's functions, level with the owner list's card. -->
        <Border x:Name="DetailCard" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="DetailHeader" Padding="16,12,16,6" BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="DetailRows" Padding="16,4,16,12" />
            </ScrollViewer>
          </Grid>
        </Border>
        <!-- Instead of the split when the tab has nothing to show, such as a range without Lua. -->
        <TextBlock x:Name="ResultMessage" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed" Style="{StaticResource SecondaryTextStyle}" />
      </Grid>
      <StackPanel x:Name="EmptyPanel" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                  MaxWidth="520" Spacing="12">
        <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center"
                   Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
