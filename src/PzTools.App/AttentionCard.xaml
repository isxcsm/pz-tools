<UserControl
    x:Class="PzTools.App.AttentionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A card that needs attention, in the one shape they all have: what happened, at most one line about it, at most
       one action as a strip across the bottom, and a ✕ that shows while the pointer or the keyboard is on it. -->
  <Border x:Name="Card" Style="{StaticResource OperationCardStyle}">
    <StackPanel Spacing="4">
      <Grid>
        <TextBlock x:Name="TitleText" Style="{StaticResource CardTitleTextStyle}" />
        <Button x:Name="CloseButton" Style="{StaticResource CardCloseButtonStyle}" Click="CloseButton_Click">
          <FontIcon Glyph="&#xE711;" FontSize="10" />
        </Button>
      </Grid>
      <TextBlock x:Name="MessageText" Style="{StaticResource CardBodyTextStyle}" Visibility="Collapsed" />
      <Button x:Name="ActionButton" Style="{StaticResource CardActionStripStyle}" Click="ActionButton_Click"
              Visibility="Collapsed">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ActionText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
          <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="11" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
