<UserControl
    x:Class="PzTools.App.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="HomePage_SizeChanged">
  <UserControl.Resources>
    <Style x:Key="HomeFeatureCardStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="HomeFeatureTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HomeFeatureActionStyle" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <!-- One line of state: no card, just a quiet row that opens its page. No left padding, so its
         icon lines up with the title's left edge and nothing reaches past the page's. -->
    <Style x:Key="HomeStatusRowStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="0,5,8,5" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
    <StackPanel x:Name="HomeContent"
                Spacing="20" Padding="0,0,4,16">
      <Grid x:Name="IntroductionGrid" RowSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Wide, this column is as tall as the artwork beside it: the title at its top, in line with
             other pages' titles, and the state rows at its bottom, so both edges meet the artwork's. -->
        <Grid x:Name="IntroductionCopy" Grid.Row="1" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid MinHeight="{StaticResource PageHeaderHeight}">
            <TextBlock Text="PZ Tools" Style="{StaticResource PageTitleTextStyle}"
                       AutomationProperties.HeadingLevel="Level1" />
          </Grid>
          <TextBlock x:Name="HomeDescription" Grid.Row="1" TextWrapping="Wrap" />
          <!-- What is going on now, read from the app's live views by the shell. -->
          <StackPanel x:Name="StatusRows" Grid.Row="2" VerticalAlignment="Bottom" Margin="0,4,0,0">
            <Button x:Name="GameStatusButton" Style="{StaticResource HomeStatusRowStyle}" Click="OpenSaves_Click"
                    AutomationProperties.AutomationId="GameStatusButton">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Grid Width="16" Margin="0,0,4,0" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                  <Ellipse x:Name="GameLiveDot" Width="8" Height="8" Visibility="Collapsed"
                           Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                </Grid>
                <TextBlock x:Name="GameStatusValue" />
                <TextBlock x:Name="GameStatusDetail" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" />
              </StackPanel>
            </Button>
            <Button x:Name="SaveStatusButton" Style="{StaticResource HomeStatusRowStyle}" Click="OpenSaves_Click"
                    AutomationProperties.AutomationId="SaveStatusButton">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE74E;" FontSize="16" Width="16" Margin="0,0,4,0" />
                <TextBlock x:Name="SaveStatusValue" />
                <TextBlock x:Name="SaveStatusDetail" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" />
                <!-- A save with nothing to go back to: the one thing here worth a warning colour. -->
                <TextBlock x:Name="SaveStatusWarning" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
              </StackPanel>
            </Button>
            <Button x:Name="ExtensionStatusButton" Style="{StaticResource HomeStatusRowStyle}" Click="OpenExtensions_Click"
                    AutomationProperties.AutomationId="ExtensionStatusButton">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE804;" FontSize="16" Width="16" Margin="0,0,4,0" />
                <TextBlock x:Name="ExtensionStatusValue" />
                <TextBlock x:Name="ExtensionStatusDetail" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" />
                <TextBlock x:Name="ExtensionStatusWarning" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Image x:Name="HomeArtwork" Source="ms-appx:///Assets/Brand/pztools-home.png"
               Height="128" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
               AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
      </Grid>

      <StackPanel Spacing="12">
        <TextBlock x:Name="HomeFeaturesHeading" Style="{StaticResource HomeFeatureTitleStyle}"
                   AutomationProperties.HeadingLevel="Level2" />
        <Grid x:Name="FeatureGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Button x:Name="BackupButton" Style="{StaticResource HomeFeatureCardStyle}" Click="OpenSaves_Click"
                  AutomationProperties.AutomationId="BackupButton">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Sync" VerticalAlignment="Top" Margin="0,2,0,0"
                          AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="HomeBackupTitle" Style="{StaticResource HomeFeatureTitleStyle}" />
                <TextBlock x:Name="HomeBackupDescription" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="HomeBackupAction" Style="{StaticResource HomeFeatureActionStyle}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button x:Name="CharacterRecoveryButton" Grid.Row="1" Style="{StaticResource HomeFeatureCardStyle}" Click="OpenSaves_Click"
                  AutomationProperties.AutomationId="CharacterRecoveryButton">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Contact" VerticalAlignment="Top" Margin="0,2,0,0"
                          AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="HomeRecoveryTitle" Style="{StaticResource HomeFeatureTitleStyle}" />
                <TextBlock x:Name="HomeRecoveryDescription" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="HomeRecoveryAction" Style="{StaticResource HomeFeatureActionStyle}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button x:Name="ProfilerButton" Grid.Row="2" Style="{StaticResource HomeFeatureCardStyle}" Click="OpenProfiler_Click"
                  AutomationProperties.AutomationId="ProfilerButton">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE9D9;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                        AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="HomeProfilerTitle" Style="{StaticResource HomeFeatureTitleStyle}" />
                <TextBlock x:Name="HomeProfilerDescription" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="HomeProfilerAction" Style="{StaticResource HomeFeatureActionStyle}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button x:Name="GameExtensionsButton" Grid.Row="3" Style="{StaticResource HomeFeatureCardStyle}" Click="OpenExtensions_Click"
                  AutomationProperties.AutomationId="GameExtensionsButton">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Setting" VerticalAlignment="Top" Margin="0,2,0,0"
                          AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="HomeExtensionsTitle" Style="{StaticResource HomeFeatureTitleStyle}" />
                <TextBlock x:Name="HomeExtensionsDescription" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="HomeExtensionsAction" Style="{StaticResource HomeFeatureActionStyle}" />
              </StackPanel>
            </Grid>
          </Button>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <HyperlinkButton Content="GitHub" Padding="0,4"
                           NavigateUri="https://github.com/isxcsm/pz-tools" />
          <HyperlinkButton x:Name="ReportIssueButton" Padding="0,4"
                           NavigateUri="https://github.com/isxcsm/pz-tools/issues" />
          <TextBlock x:Name="HomeVersion" Text="v0.2.0" IsTextSelectionEnabled="True"
                     VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
        <TextBlock x:Name="HomeUnofficialNotice" Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
