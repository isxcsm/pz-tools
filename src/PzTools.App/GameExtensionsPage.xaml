<UserControl
    x:Class="PzTools.App.GameExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
  <UserControl.Resources>
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="{StaticResource CardPageHeaderMargin}" MinHeight="{StaticResource PageHeaderHeight}">
      <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleTextStyle}"
                 AutomationProperties.HeadingLevel="Level1" />
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <ProgressRing x:Name="LoadingIndicator" IsActive="False" Visibility="Collapsed"
                      HorizontalAlignment="Center" />
        <!-- Shown only with [experimental] startup_loader in the app's advanced settings (docs/design/startup-loader.md). -->
        <toolkit:SettingsCard x:Name="StartupLoaderCard" Visibility="Collapsed">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B5;" /></toolkit:SettingsCard.HeaderIcon>
          <ToggleSwitch x:Name="StartupLoaderSwitch" Toggled="StartupLoaderSwitch_Toggled" />
        </toolkit:SettingsCard>
        <!-- PZ Extension API, a program of its own that the app helps install; shown with the startup loader. -->
        <toolkit:SettingsCard x:Name="ExtensionApiCard" Visibility="Collapsed">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE943;" /></toolkit:SettingsCard.HeaderIcon>
          <ToggleSwitch x:Name="ExtensionApiSwitch" Toggled="ExtensionApiSwitch_Toggled" />
        </toolkit:SettingsCard>
        <ItemsControl ItemsSource="{x:Bind Sections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="{StaticResource SettingsCardSpacing}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
