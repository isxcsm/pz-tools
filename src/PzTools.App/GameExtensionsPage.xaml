<UserControl
    x:Class="PzTools.App.GameExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="24,24,24,16" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="PageDescription" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <InfoBar x:Name="ErrorInfo" IsClosable="True" Severity="Error" />
      <ProgressRing x:Name="Loading" IsActive="False" Visibility="Collapsed"
                    HorizontalAlignment="Center" />
      <StackPanel x:Name="Cards" Spacing="8" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
