<UserControl
    x:Class="PzTools.App.GameExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="{StaticResource CardPageHeaderMargin}" MinHeight="{StaticResource PageHeaderHeight}">
      <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleTextStyle}"
                 AutomationProperties.HeadingLevel="Level1" />
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <InfoBar x:Name="ErrorInfo" IsClosable="True" Severity="Error"
                 Visibility="{x:Bind ErrorInfo.IsOpen, Mode=OneWay}" />
        <ProgressRing x:Name="LoadingIndicator" IsActive="False" Visibility="Collapsed"
                      HorizontalAlignment="Center" />
        <StackPanel x:Name="Cards" Spacing="8" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
