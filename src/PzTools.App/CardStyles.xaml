<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The cards in the navigation pane, work and attention alike, in one place: 13 for the title, 12 for the rest
       (as the next-backup line), tight padding. The title is set apart by size and colour, not weight: the Korean
       system font has no semibold. See docs/design/ui-ux-contract.md, "Writing a card". -->

  <!-- The card's padding and corner, and the action strip that fills a card's bottom edge. The strip's margin is
       the padding turned outward (plus 6 above it): change one, change the other. -->
  <Thickness x:Key="CardPadding">12,10</Thickness>
  <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
  <Thickness x:Key="CardActionStripMargin">-12,6,-12,-10</Thickness>
  <Thickness x:Key="CardActionStripPadding">12,7</Thickness>
  <CornerRadius x:Key="CardActionStripCornerRadius">0,0,6,6</CornerRadius>

  <Style x:Key="OperationCardStyle" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
  </Style>

  <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Colours for text in cards, also those built in code. Set through styles, so they follow the window's theme
       (and its changes) like XAML does; a brush looked up in code follows Windows' theme instead. -->
  <Style x:Key="OperationCardSecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="CardBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OperationCardSecondaryTextStyle}">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- A card's ✕: unseen until the pointer or the keyboard is on its card (AttentionCard), so a card that stays
       until its condition clears shows no button it does not need. It lies over the corner, taking no width from
       the title. -->
  <Style x:Key="CardCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,-7,-9,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- A card's one action, as a grey strip across its bottom edge: its words line up with the title's. The grey
       comes from the pane's button colours (MainWindowShell, ProgressCards); no border, which would show the
       card's white around the strip. -->
  <Style x:Key="CardActionStripStyle" TargetType="Button">
    <Setter Property="Margin" Value="{StaticResource CardActionStripMargin}" />
    <Setter Property="Padding" Value="{StaticResource CardActionStripPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource CardActionStripCornerRadius}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="OperationSucceededIconStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
  </Style>
  <Style x:Key="OperationFailedIconStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
  </Style>
  <Style x:Key="OperationDegradedIconStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
  </Style>
  <Style x:Key="OperationNeutralIconStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
</ResourceDictionary>
