                        VerticalAlignment="Center" IsHitTestVisible="False" UseLayoutRounding="False"
                        AutomationProperties.AccessibilityView="Raw" />
            </Canvas>
            <StackPanel x:Name="CoffeeSupportCopy" Grid.Column="1" Margin="10,0,0,0" Spacing="3"
                        VerticalAlignment="Center">
              <TextBlock x:Name="CoffeeSupportMessage" FontSize="11" TextWrapping="Wrap"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="CoffeeSupportTitle" FontSize="12" FontWeight="Normal" TextWrapping="Wrap"
                         Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
          </Grid>
        </HyperlinkButton>
      </Grid>
      </StackPanel>
    </NavigationView.PaneHeader>
    <NavigationView.MenuItems>
      <NavigationViewItem x:Name="HomeItem" Tag="home">
        <NavigationViewItem.Icon>
          <ImageIcon Width="20" Height="20">
            <ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Navigation/home.svg" /></ImageIcon.Source>
          </ImageIcon>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="SavesItem" x:Uid="SavesNavigation" Content="세이브 관리" Tag="saves">
        <NavigationViewItem.Icon>
          <ImageIcon Width="20" Height="20">
            <ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Navigation/saves.svg" /></ImageIcon.Source>
          </ImageIcon>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="ProfilerItem" Content="Performance" Tag="profiler">
        <NavigationViewItem.Icon>
          <ImageIcon Width="20" Height="20">
            <ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Navigation/profiler.svg" /></ImageIcon.Source>
          </ImageIcon>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="GameExtensionsItem" Content="Game Extensions" Tag="game-extensions">
        <NavigationViewItem.Icon>
          <ImageIcon Width="20" Height="20">
            <ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Navigation/extensions.svg" /></ImageIcon.Source>
          </ImageIcon>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="LogsItem" Content="로그" Tag="logs">
        <NavigationViewItem.Icon>
          <ImageIcon Width="20" Height="20">
            <ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Navigation/logs.svg" /></ImageIcon.Source>
          </ImageIcon>
        </NavigationViewItem.Icon>
        <NavigationViewItem.InfoBadge>
          <InfoBadge x:Name="LogsUnreadBadge" Value="0" Visibility="Collapsed"
                     Style="{ThemeResource InformationalValueInfoBadgeStyle}" />
        </NavigationViewItem.InfoBadge>
      </NavigationViewItem>
    </NavigationView.MenuItems>
    <NavigationView.PaneFooter>
      <StackPanel x:Name="ProgressCards" Spacing="6" Margin="16,8,16,12">
        <StackPanel.Resources>
          <!-- An action in a card, and the update line: a plain grey fill and no border, set apart from the
               white cards as something to press without a frame or a colour of its own. Darker under the
               pointer, lighter while pressed. The ✕ buttons keep the subtle style, which these keys leave alone. -->
          <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
              <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="ButtonBackground" Color="#14FFFFFF" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1FFFFFFF" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0DFFFFFF" />
              </ResourceDictionary>
              <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="ButtonBackground" Color="#0F000000" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#17000000" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0A000000" />
              </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
          </ResourceDictionary>
        </StackPanel.Resources>
        <!-- One card per piece of work, filled from OperationCardStack: lowest priority on top,
             the newest card of the highest priority just above the fixed schedule line. The result
             of an action that runs no worker is a card here too, with the user's other work. -->
        <StackPanel x:Name="OperationCards" Spacing="6" Visibility="Collapsed">
          <StackPanel.ChildrenTransitions>
            <TransitionCollection>
              <AddDeleteThemeTransition />
              <RepositionThemeTransition />
            </TransitionCollection>
          </StackPanel.ChildrenTransitions>
        </StackPanel>
        <!-- Cards that need the user's attention. They outrank every status card, so they sit closest
             to the fixed schedule line, and they never expire: they leave when the condition clears or
             through the ✕ that shows while the pointer or the keyboard is on them. Every such card says what
             happened in its title, then at most one line and one action. -->
        <StackPanel x:Name="InteractiveCards" Spacing="6" Visibility="Collapsed">
          <!-- Each in the shape every attention card shares (AttentionCard); the shell sets the words and when they show. -->
          <!-- Part of the saves page that could not be read for a while; it is tried again on its own. -->
          <local:AttentionCard x:Name="LoadFailureCard" Visibility="Collapsed" Closed="LoadFailureClose_Click" />
          <local:AttentionCard x:Name="ComponentBlockedCard" Visibility="Collapsed"
                               Closed="ComponentBlockedClose_Click" Action="ComponentBlockedOpen_Click" />
          <local:AttentionCard x:Name="GameLinkCard" Visibility="Collapsed" Closed="GameLinkClose_Click" />
          <!-- A game update put the game's own memory back over the player's choice. -->
          <local:AttentionCard x:Name="GameMemoryCard" Visibility="Collapsed"
                               Closed="GameMemoryClose_Click" Action="GameMemoryReapply_Click" />
        </StackPanel>
        <Border Padding="{StaticResource CardPadding}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{StaticResource CardCornerRadius}">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE787;" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock x:Name="NextBackupText" Text="다음 백업: 대기 중"
                         TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
              <TextBlock x:Name="NextBackupRemainingText" Visibility="Collapsed"
                         FontSize="12" FontWeight="Normal" TextWrapping="NoWrap"
                         Style="{StaticResource SecondaryTextStyle}" />
              <!-- While a hotkey has paused automatic backups: they can be resumed here too, not only by the key. -->
              <HyperlinkButton x:Name="ResumeBackupsButton" Visibility="Collapsed" Padding="0" FontSize="12"
                               Click="ResumeBackupsButton_Click" AutomationProperties.AutomationId="ResumeBackupsButton" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- About the app itself rather than the game or its saves, so it has its own place, last, set apart from the
             cards and close to Settings, where its details are: a newer release, one line until the app is updated, pressed to
             open the release's page. The notice is turned off in the settings, not here. Its bottom margin takes back
             the pane's, so it sits against Settings, while the next-backup line keeps that gap when it is hidden. -->
        <Button x:Name="UpdateCard" Visibility="Collapsed" Click="UpdateCard_Click" Margin="0,6,0,-12"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8" CornerRadius="4"
                AutomationProperties.AutomationId="UpdateCard">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UpdateCardText" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="11" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>
        </Button>
      </StackPanel>
    </NavigationView.PaneFooter>
    <Grid x:Name="PageContent" Background="Transparent" Padding="{StaticResource PageContentPadding}">
      <!-- Disabled and hidden from screen readers while another page is shown: the page stays realized
           (rows, selection, scroll) but its buttons cannot be reached with Tab. See PresentContent. -->
      <ContentControl x:Name="SavesHost" IsTabStop="False" IsEnabled="False"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      AutomationProperties.AccessibilityView="Raw">
      <Grid x:Name="SavesRoot" ColumnSpacing="12" SizeChanged="SavesRoot_SizeChanged"
            Opacity="0" IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ListColumn" Width="420" MinWidth="320" />
          <ColumnDefinition x:Name="DetailColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="ListPane" Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid x:Name="SavesHeader" Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="12" MinHeight="{StaticResource PageHeaderHeight}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="{StaticResource PageHeaderHeight}" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SavesPageTitle" Text="세이브 관리" Style="{StaticResource PageTitleTextStyle}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       AutomationProperties.HeadingLevel="Level1" />
            <StackPanel x:Name="SavesHeaderActions" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="6">
              <Button x:Name="ImportButton" x:Uid="ImportArchive" VerticalAlignment="Center"
                      Style="{StaticResource SubtleButtonStyle}"
                      Content="압축 파일 가져오기" Click="ImportButton_Click" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="SaveList" ItemsSource="{x:Bind SaveItems, Mode=OneWay}"
                      Padding="4" ItemContainerStyle="{StaticResource ContentListItemStyle}"
                      SelectionChanged="SaveList_SelectionChanged">
              <ListView.ItemContainerTransitions>
                <TransitionCollection />
              </ListView.ItemContainerTransitions>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SaveListUiItem">
                  <Grid Padding="4,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="96" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="96" Height="96">
                      <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              CornerRadius="4">
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                      </Border>
                      <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}"
                              Background="#6600A65A" CornerRadius="27"
                              Width="42" Height="42" HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" Foreground="White" FontSize="20" />
                      </Border>
                      <Image Visibility="{x:Bind DeadVisibility, Mode=OneWay}" Width="30" Height="30" Margin="0,2,2,0"
                             HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Navigation/skull.svg" /></Image.Source>
                      </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:AppToolTip.Tip="{x:Bind Name, Mode=OneWay}" />
                      <TextBlock Text="{x:Bind Mode, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" />
                      <TextBlock Text="{x:Bind LastPlayedText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            local:AppToolTip.Tip="{x:Bind DeleteTooltip, Mode=OneWay}">
                      <Button Style="{StaticResource RowDeleteButtonStyle}"
                              IsEnabled="{x:Bind CanDelete, Mode=OneWay}" Click="DeleteSave_Click"
                              AutomationProperties.HelpText="{x:Bind DeleteTooltip, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind DeleteLabel, Mode=OneWay}">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                      </Button>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <Canvas x:Name="SaveSelectionLayer" IsHitTestVisible="False">
              <Border x:Name="SaveSelectionBar" Width="3" Height="20" Canvas.Left="10"
                      CornerRadius="2" Visibility="Collapsed"
                      Background="{ThemeResource AccentFillColorDefaultBrush}" />
            </Canvas>
            <StackPanel x:Name="LoadingSaves" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False">
              <ProgressRing x:Name="LoadingSavesProgress" Width="28" Height="28" IsActive="True"
                            AutomationProperties.LabeledBy="{Binding ElementName=LoadingSavesText}" />
              <TextBlock x:Name="LoadingSavesText" Text="세이브를 불러오는 중입니다"
                         Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel x:Name="EmptySaves" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="8">
              <FontIcon Glyph="&#xE8B7;" FontSize="32" Opacity="0.5" />
              <TextBlock x:Name="NoSavesText" x:Uid="NoSaves" Text="세이브가 없습니다" Opacity="0.7" />
            </StackPanel>
            <StackPanel x:Name="UnavailableSaves" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="8" Margin="24" IsHitTestVisible="False">
              <FontIcon Glyph="&#xE7BA;" FontSize="28" Opacity="0.6" />
              <TextBlock x:Name="SavesUnavailableText" Text="일부 정보를 갱신할 수 없습니다"
                         Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                         TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Grid>
        </Grid>
        <Grid x:Name="DetailPane" Grid.Column="1" RowSpacing="12" SizeChanged="DetailPane_SizeChanged">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="NoSelection" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock x:Name="SelectSaveText" x:Uid="SelectSave" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="세이브를 선택하세요" Opacity="0.65" />
          </Grid>
          <Grid x:Name="DetailContent" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
              <Grid x:Name="BackupRevisionsHeader" Margin="{StaticResource PageHeaderMargin}" MinHeight="{StaticResource PageHeaderHeight}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" MinHeight="{StaticResource PageHeaderHeight}" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="BackupRevisionsText" x:Uid="BackupRevisions" Text="현재 세이브 및 백업"
                           Style="{StaticResource PageTitleTextStyle}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2" />
                <StackPanel x:Name="BackupRevisionsActions" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="6">
                  <Button x:Name="DeleteAllBackupsButton" VerticalAlignment="Center"
                          Style="{StaticResource SubtleButtonStyle}"
                          Content="백업 모두 삭제" IsEnabled="False" Click="DeleteAllBackupsButton_Click" />
                  <Button x:Name="NarrowBackButton" x:Uid="BackToList" Visibility="Collapsed"
                          Content="목록으로" Style="{StaticResource SubtleButtonStyle}"
                          VerticalAlignment="Center" Click="NarrowBackButton_Click" />
                </StackPanel>
              </Grid>
              <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <Grid>
              <ListView x:Name="RevisionList" Visibility="Collapsed" ItemsSource="{x:Bind RevisionItems, Mode=OneWay}"
                        Padding="4"
                        ItemContainerStyle="{StaticResource ContentListItemStyle}"
                        SelectionChanged="RevisionList_SelectionChanged"
                        ContainerContentChanging="RevisionList_ContainerContentChanging">
                <ListView.ItemContainerTransitions>
                  <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:SaveVersionUiItem">
                    <Grid Padding="10,10,4,10" ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="90" Height="90">
                        <Border CornerRadius="4"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                          <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <Image Visibility="{x:Bind DeadVisibility, Mode=OneWay}" Width="30" Height="30"
                               Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Navigation/skull.svg" /></Image.Source>
                        </Image>
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <Grid ColumnSpacing="4" HorizontalAlignment="Left" MinHeight="28"
                              local:AppToolTip.Tip="{x:Bind RevisionText, Mode=OneWay}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{x:Bind RevisionText, Mode=OneWay}"
                                     Visibility="{x:Bind NameDisplayVisibility, Mode=OneWay}"
                                     FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                     FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                          <TextBox Style="{StaticResource InlineRevisionNameTextBoxStyle}"
                                   Visibility="{x:Bind NameEditorVisibility, Mode=OneWay}"
                                   Text="{x:Bind EditableNameText, Mode=OneWay}"
                                   PlaceholderText="{x:Bind NamePlaceholderText, Mode=OneWay}"
                                   IsTabStop="{x:Bind IsEditing, Mode=OneWay}"
                                   MaxLength="100" VerticalAlignment="Center"
                                   KeyDown="RevisionNameEditor_KeyDown" LostFocus="RevisionNameEditor_LostFocus"
                                   AutomationProperties.Name="{x:Bind EditLabel, Mode=OneWay}" />
                          <Button Grid.Column="1" Style="{StaticResource RowDeleteButtonStyle}" Width="24" Height="24"
                                  Visibility="{x:Bind ClearNameVisibility, Mode=OneWay}"
                                  IsTabStop="False" AllowFocusOnInteraction="False"
                                  Click="RevisionNameClear_Click"
                                  local:AppToolTip.Tip="{x:Bind ClearNameLabel, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind ClearNameLabel, Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                          </Button>
                          <Button Grid.Column="1" Style="{StaticResource RowDeleteButtonStyle}" Width="28" Height="28"
                                  Visibility="{x:Bind EditVisibility, Mode=OneWay}" IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                                  Click="RenameRevision_Click" local:AppToolTip.Tip="{x:Bind EditLabel, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind EditLabel, Mode=OneWay}">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                          </Button>
                        </Grid>
                        <TextBlock Text="{x:Bind CharacterText, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid Height="20">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind SurvivalText, Mode=OneWay}" local:AppToolTip.Tip="{x:Bind SurvivalReadError, Mode=OneWay}"
                                       FontSize="14" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressRing Width="12" Height="12" IsActive="{x:Bind IsSurvivalPending, Mode=OneWay}"
                                          Visibility="{x:Bind SurvivalProgressVisibility, Mode=OneWay}"
                                          IsHitTestVisible="False" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
                      <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,8,0"
                                 Text="{x:Bind AutomaticSaveLabel, Mode=OneWay}"
                                 Visibility="{x:Bind AutomaticSaveVisibility, Mode=OneWay}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,8,0"
                                 Text="{x:Bind GameVersionText, Mode=OneWay}"
                                 Visibility="{x:Bind GameVersionVisibility, Mode=OneWay}"
                                 local:AppToolTip.Tip="{x:Bind GameVersionTip, Mode=OneWay}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <Border Grid.Column="3" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{x:Bind HealVisibility}" local:AppToolTip.Tip="{x:Bind HealTooltip, Mode=OneWay}">
                        <Button Style="{StaticResource RowDeleteButtonStyle}" IsEnabled="{x:Bind CanHeal, Mode=OneWay}"
                                Click="HealCharacter_Click" AutomationProperties.HelpText="{x:Bind HealTooltip, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind HealLabel, Mode=OneWay}">
                          <FontIcon Glyph="&#xE95E;" FontSize="16" />
                        </Button>
                      </Border>
                      <Button Grid.Column="3" Style="{StaticResource RowDeleteButtonStyle}"
                              Visibility="{x:Bind DeleteVisibility}" IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                              Click="DeleteRevision_Click" local:AppToolTip.Tip="{x:Bind DeleteLabel, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind DeleteLabel, Mode=OneWay}">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                  <TextBlock x:Name="NoBackups" x:Uid="NoBackups" Text="아직 백업이 없습니다" Visibility="Collapsed"
                             HorizontalAlignment="Stretch" TextAlignment="Center" Padding="24,36"
                             Style="{StaticResource SecondaryTextStyle}" />
                </ListView.Footer>
              </ListView>
              <Canvas x:Name="RevisionSelectionLayer" IsHitTestVisible="False">
                <Border x:Name="RevisionSelectionBar" Width="3" Height="20" Canvas.Left="12"
                        CornerRadius="2" Visibility="Collapsed"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
              </Canvas>
              <StackPanel x:Name="LoadingBackups" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Spacing="12" Padding="24,36" IsHitTestVisible="False">
                <!-- Active only while its panel shows: a collapsed ring still animates on the compositor. -->
                <ProgressRing x:Name="LoadingBackupsProgress" Width="28" Height="28" IsActive="False" />
                <TextBlock x:Name="LoadingBackupsText" Text="세이브 정보를 불러오는 중입니다"
                           Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
              </Grid>
              </Border>
          </Grid>
          <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  CornerRadius="8" Padding="12">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <!-- Enabled hover hosts keep restriction tooltips available around disabled buttons. -->
              <Border x:Name="RestoreToolTipHost" Background="Transparent"
                      HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="RestoreButton" x:Uid="Restore" Content="복구하기"
                        Style="{StaticResource SubtleButtonStyle}"
                        IsEnabled="False" Click="RestoreButton_Click" />
              </Border>
              <StackPanel x:Name="RightDetailActions" Grid.Column="1" Orientation="Horizontal"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <Border x:Name="ExportToolTipHost" Background="Transparent" HorizontalAlignment="Right">
                  <Button x:Name="ExportButton" x:Uid="ExportArchive" Content="압축 파일로 내보내기"
                          Style="{StaticResource SubtleButtonStyle}"
                          IsEnabled="False" Click="ExportButton_Click" />
                </Border>
                <Button x:Name="ManualBackupButton" x:Uid="ManualBackup" Content="수동 백업"
                        Style="{StaticResource ManualBackupButtonStyle}"
                        Click="ManualBackupButton_Click">
                  <Button.Resources>
                    <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver"
                                     Color="{ThemeResource TextFillColorPrimary}" Opacity="0.12" />
                    <SolidColorBrush x:Key="SubtleButtonBackgroundPressed"
                                     Color="{ThemeResource TextFillColorPrimary}" Opacity="0.16" />
                    <SolidColorBrush x:Key="SubtleButtonBackgroundDisabled"
                                     Color="{ThemeResource TextFillColorPrimary}" Opacity="0.05" />
                  </Button.Resources>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <ProgressBar x:Name="DetailTransitionProgress" Grid.ColumnSpan="2"
                     Height="2" VerticalAlignment="Top" IsIndeterminate="False"
                     Visibility="Collapsed" Canvas.ZIndex="10" IsHitTestVisible="False" />
      </Grid>
      </ContentControl>
      <local:HomePage x:Name="HomeRoot" />
      <local:LogsPage x:Name="LogsRoot" Visibility="Collapsed" />
      <local:SettingsPage x:Name="SettingsRoot" Visibility="Collapsed" />
      <local:GameExtensionsPage x:Name="GameExtensionsRoot" Visibility="Collapsed" />
      <local:ProfilerPage x:Name="ProfilerRoot" Visibility="Collapsed" />
    </Grid>
  </NavigationView>
  </Grid>
</UserControl>
