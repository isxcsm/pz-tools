<UserControl
    x:Class="PzTools.App.MainWindowShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PzTools.App">
  <UserControl.Resources>
    <!-- The cards' look is shared with every card in the pane: CardStyles.xaml. -->
    <Style x:Key="SuspendedCountdownTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- The tall brand occupies only the rail, not a full-width content row.
         The top 32 DIPs remain the title-bar drag region; page controls are below it. -->
    <Grid x:Name="AppTitleBar" Background="Transparent" Margin="0,0,140,0" />
    <Grid x:Name="AppBrand" Grid.RowSpan="2" Canvas.ZIndex="1" Width="212"
          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,20,12,0"
          ColumnSpacing="14" IsHitTestVisible="False">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Image x:Name="BrandImage" Width="56" Height="56" Source="ms-appx:///Assets/Brand/pztools.png"
             Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
      <StackPanel x:Name="BrandCopy" Grid.Column="1" Spacing="1" VerticalAlignment="Center">
        <TextBlock x:Name="AppTitleText" Text="PZ Tools" Style="{ThemeResource TitleTextBlockStyle}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="AppSubtitleText" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Grid>
  <!-- The pane folds to its icons only below 900: a 1366-wide laptop at 125% and half of a 1920 screen keep it open. -->
  <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="True"
                  IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto" IsPaneToggleButtonVisible="False"
                  OpenPaneLength="248" ExpandedModeThresholdWidth="900"
                  CompactModeThresholdWidth="0" IsTitleBarAutoPaddingEnabled="False"
                  SelectionChanged="Navigation_SelectionChanged" ItemInvoked="Navigation_ItemInvoked"
                  DisplayModeChanged="Navigation_DisplayModeChanged"
                  PaneOpened="Navigation_PaneChanged" PaneClosed="Navigation_PaneChanged">
    <NavigationView.Resources>
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
      <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
      <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
      <!-- 기본 16px Viewbox가 컬러 SVG를 재축소하지 않도록 실제 도형 크기를 약 20px로 맞춥니다. -->
      <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
    </NavigationView.Resources>
    <NavigationView.PaneHeader>
      <StackPanel>
      <Grid x:Name="BrandHeaderSpace" Height="48" />
      <Grid x:Name="CoffeeSupportArea" Margin="12,8,12,4">
        <HyperlinkButton x:Name="CoffeeSupportButton" IsEnabled="False" Padding="10" MinHeight="40"
                         Loaded="CoffeeSupportButton_Loaded" Unloaded="CoffeeSupportButton_Unloaded"
                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                         Background="Transparent" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="8">
          <!-- Preserve native input/focus states. Icon feedback follows the template's
               foreground; both text lines keep their neutral colors. -->
          <HyperlinkButton.Resources>
            <ResourceDictionary>
              <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                  <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#C3A574" />
                  <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#C3A574" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                  <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#8B6B42" />
                  <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#8B6B42" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                  <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" />
                  <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
              </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
          </HyperlinkButton.Resources>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <!-- A fixed slot prevents label movement while the vector itself resizes.
                 Canvas leaves room for the small hover expansion without clipping. -->
            <Canvas x:Name="CoffeeSupportIconHost" Width="20" Height="28" VerticalAlignment="Center">
