<UserControl
    x:Class="PzTools.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    SizeChanged="SettingsPage_SizeChanged">
  <UserControl.Resources>
    <!-- The same card and section spacing as the WinUI Gallery settings page. -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- Colours for what code sets, resolved in the page's own theme (the app's resources follow Windows', not the
         theme chosen in PZ Tools). Never shown. -->
    <StackPanel x:Name="ThemeProbes" Visibility="Collapsed">
      <Border x:Name="CautionBackgroundProbe" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
      <Border x:Name="CautionProbe" Background="{ThemeResource SystemFillColorCautionBrush}" />
    </StackPanel>

    <Grid Margin="{StaticResource CardPageHeaderMargin}" MinHeight="{StaticResource PageHeaderHeight}">
      <TextBlock x:Name="SettingsTitleText" Text="Settings"
                 AutomationProperties.HeadingLevel="Level1"
                 Style="{StaticResource PageTitleTextStyle}" />
    </Grid>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">
      <Border>
        <StackPanel x:Name="SettingsSections" HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">
          <!-- Reflow transitions are attached after the initial expanded layout.
               MainWindowShell owns the page entrance animation. -->

          <!-- The app's version and its updates, folded: whether it is the newest is the line's description and the
               version its value, as every other setting; checking now and the notice's switch are inside. A newer release is offered there, and in the
               pane, until the app is updated. -->
          <toolkit:SettingsExpander x:Name="UpdateSection" IsExpanded="False" Header="Version"
                                    AutomationProperties.AutomationId="UpdateSection">
            <TextBlock x:Name="UpdateVersionText" VerticalAlignment="Center" />
            <toolkit:SettingsExpander.Items>
              <toolkit:SettingsCard x:Name="UpdateCheckCard" Header="Check for updates">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Sync" /></toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ProgressRing x:Name="UpdateCheckProgress" Width="16" Height="16" MinWidth="16" MinHeight="16"
                                IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                  <Button x:Name="UpdateDownloadButton" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed"
                          Click="UpdateDownload_Click" AutomationProperties.AutomationId="UpdateDownloadButton" />
                  <Button x:Name="UpdateCheckButton" Click="UpdateCheck_Click" AutomationProperties.AutomationId="UpdateCheckButton" />
                </StackPanel>
              </toolkit:SettingsCard>
              <!-- Where the newest version is downloaded, in the browser, whatever the last check found. -->
              <toolkit:SettingsCard x:Name="UpdateReleasePageCard" Header="Download page">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE896;" /></toolkit:SettingsCard.HeaderIcon>
                <!-- A button like its neighbours', with the mark of a page that opens outside the app. -->
                <Button x:Name="UpdateReleasePageButton" Click="UpdateReleasePage_Click"
                        AutomationProperties.AutomationId="UpdateReleasePageButton">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="UpdateReleasePageButtonText" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </toolkit:SettingsCard>
              <toolkit:SettingsCard x:Name="UpdateAutoSettingCard" Header="New version notice">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEA8F;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="UpdateAutoToggle" Toggled="SettingChanged" AutomationProperties.AutomationId="UpdateAutoToggle" />
              </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
          </toolkit:SettingsExpander>
          <toolkit:SettingsExpander x:Name="DisplaySection" IsExpanded="True"
                                    Header="Appearance and behavior" Description="Choose the language, theme, and what happens when you close the window.">
            <toolkit:SettingsExpander.Items>
          <toolkit:SettingsCard x:Name="LanguageSettingCard"
                                Header="Language" Description="Choose the app language. Untranslated items appear in English.">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Globe" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Name="LanguageCombo" MinWidth="200" MaxWidth="320"
                      SelectionChanged="SettingChanged" />
          </toolkit:SettingsCard>
          <toolkit:SettingsCard x:Name="ThemeSettingCard"
                                Header="Theme" Description="Use your Windows theme or choose a light or dark theme.">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="View" /></toolkit:SettingsCard.HeaderIcon>
            <ComboBox x:Name="ThemeCombo" MinWidth="200" SelectionChanged="SettingChanged">
              <ComboBoxItem x:Name="ThemeSystemItem" Content="System" Tag="System" />
              <ComboBoxItem x:Name="ThemeLightItem" Content="Light" Tag="Light" />
              <ComboBoxItem x:Name="ThemeDarkItem" Content="Dark" Tag="Dark" />
            </ComboBox>
          </toolkit:SettingsCard>
          <toolkit:SettingsCard x:Name="SystemTraySettingCard"
                                Header="System tray" Description="Keep PZ Tools running when you close the window. To quit, right-click its icon next to the taskbar clock and choose Exit.">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Setting" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="SystemTrayToggle" Toggled="SettingChanged" />
          </toolkit:SettingsCard>

            </toolkit:SettingsExpander.Items>
          </toolkit:SettingsExpander>
          <toolkit:SettingsExpander x:Name="PathSection" IsExpanded="True"
                                    Header="Folders" Description="Choose where save and backup files are stored.">
            <toolkit:SettingsExpander.Items>
          <toolkit:SettingsCard x:Name="SavesPathSettingCard" Header="Save folder">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Folder" /></toolkit:SettingsCard.HeaderIcon>
            <Grid x:Name="SavesPathEditor" Width="500" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SavesPath" LostFocus="PathSettingChanged" />
              <Button x:Name="SavesBrowseButton" Grid.Column="1"
                      Style="{StaticResource SubtleButtonStyle}"
                      Content="Browse" Tag="saves" Click="BrowseFolder_Click" />
              <Button x:Name="SavesOpenButton" Grid.Column="2"
                      Style="{StaticResource SubtleButtonStyle}"
                      Content="Open folder" Tag="saves" Click="OpenPathFolder_Click" />
            </Grid>
          </toolkit:SettingsCard>
          <toolkit:SettingsCard x:Name="BackupPathSettingCard" Header="Backup folder">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="SyncFolder" /></toolkit:SettingsCard.HeaderIcon>
            <Grid x:Name="BackupPathEditor" Width="500" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="BackupPath" LostFocus="PathSettingChanged" />
              <Button x:Name="BackupBrowseButton" Grid.Column="1"
                      Style="{StaticResource SubtleButtonStyle}"
                      Content="Browse" Tag="backup" Click="BrowseFolder_Click" />
              <Button x:Name="BackupOpenButton" Grid.Column="2"
                      Style="{StaticResource SubtleButtonStyle}"
                      Content="Open folder" Tag="backup" Click="OpenPathFolder_Click" />
            </Grid>
          </toolkit:SettingsCard>

            </toolkit:SettingsExpander.Items>
          </toolkit:SettingsExpander>
          <toolkit:SettingsExpander x:Name="BackupSection" IsExpanded="True"
                                    Header="Backup" Description="Set the automatic backup interval, how many backups to keep, and saving the game before a backup.">
            <toolkit:SettingsExpander.Items>
          <toolkit:SettingsCard x:Name="AutomaticBackupSettingCard" Header="Automatic backups">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Sync" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="AutomaticBackupToggle" Toggled="AutomaticBackupToggle_Toggled" />
          </toolkit:SettingsCard>
          <toolkit:SettingsCard x:Name="IntervalSettingCard"
                                Header="Backup interval" Description="Time between automatic backups (1–60 minutes). Changing it restarts the count.">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Clock" /></toolkit:SettingsCard.HeaderIcon>
            <Grid x:Name="IntervalEditor" Width="340" ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="IntervalSlider" Minimum="1" Maximum="60"
                      StepFrequency="1" ValueChanged="IntervalSlider_ValueChanged" />
              <NumberBox x:Name="IntervalNumber" Grid.Column="1" Minimum="1" Maximum="60"
                         SpinButtonPlacementMode="Inline" ValueChanged="IntervalNumber_ValueChanged" />
            </Grid>
          </toolkit:SettingsCard>
          <toolkit:SettingsCard x:Name="PausePeriodicSettingCard" Header="Delay scheduled backups while paused or asleep">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Pause" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="PausePeriodicToggle" Toggled="SettingChanged" />
          </toolkit:SettingsCard>
          <toolkit:SettingsCard x:Name="RetentionSettingCard"
                                Header="Automatic backups to keep" Description="Keeps this many of the most recent automatic backups and deletes older ones (1–100). Manual backups are not counted; they are deleted only with their save.">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Library" /></toolkit:SettingsCard.HeaderIcon>
            <Grid x:Name="RetentionEditor" Width="340" ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="RetentionSlider" Minimum="1" Maximum="100"
                      StepFrequency="1" ValueChanged="RetentionSlider_ValueChanged" />
              <NumberBox x:Name="RetentionNumber" Grid.Column="1" Minimum="1" Maximum="100"
                         SpinButtonPlacementMode="Inline" ValueChanged="RetentionNumber_ValueChanged" />
            </Grid>
          </toolkit:SettingsCard>
          <toolkit:SettingsCard x:Name="DeathBackupSettingCard" Header="Back up when the character dies">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="ProtectedDocument" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="DeathBackupToggle" Toggled="SettingChanged" />
          </toolkit:SettingsCard>
          <toolkit:SettingsCard x:Name="GameSaveSettingCard" Header="Save game before backup">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Save" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="GameSaveToggle" Toggled="SettingChanged" />
          </toolkit:SettingsCard>
          <toolkit:SettingsCard x:Name="GameSaveCountdownSettingCard" Header="In-game save countdown">
            <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Clock" /></toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="GameSaveCountdownToggle" Toggled="SettingChanged" />
          </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
          </toolkit:SettingsExpander>
          <!-- The game's own launch settings, kept in the game folder; they take effect at the game's next start. -->
          <toolkit:SettingsExpander x:Name="GameSection" IsExpanded="True" Header="Game">
            <toolkit:SettingsExpander.Items>
              <toolkit:SettingsCard x:Name="GameMemorySettingCard" Header="Game memory">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEEA0;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="GameMemoryCombo" MinWidth="180" SelectionChanged="GameMemoryCombo_SelectionChanged"
                          DropDownOpened="GameMemoryCombo_DropDownOpened" DropDownClosed="GameMemoryCombo_DropDownClosed" />
              </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
          </toolkit:SettingsExpander>
          <toolkit:SettingsExpander x:Name="ProfilerSection" IsExpanded="True" Header="Performance"
                                    Description="The game keeps its last few minutes, so a stutter can be saved after it happened.">
            <toolkit:SettingsExpander.Items>
              <toolkit:SettingsCard x:Name="RollingSettingCard" Header="Keep the last minutes">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Clock" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="RollingToggle" Toggled="RollingSettingChanged" />
              </toolkit:SettingsCard>
              <toolkit:SettingsCard x:Name="RollingModeSettingCard" Header="Mode">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Setting" /></toolkit:SettingsCard.HeaderIcon>
                <!-- Off is Standard, on is Detailed, as the Performance page's own switch. -->
                <ToggleSwitch x:Name="RollingModeToggle" Toggled="RollingSettingChanged" />
              </toolkit:SettingsCard>
              <toolkit:SettingsCard x:Name="RollingMinutesSettingCard" Header="Length (minutes)">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Clock" /></toolkit:SettingsCard.HeaderIcon>
                <Grid x:Name="RollingMinutesEditor" Width="340" ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="RollingMinutesSlider" Minimum="1" Maximum="10"
                          StepFrequency="1" ValueChanged="RollingMinutesSlider_ValueChanged" />
                  <NumberBox x:Name="RollingMinutesNumber" Grid.Column="1" Minimum="1" Maximum="10"
                             SpinButtonPlacementMode="Inline" ValueChanged="RollingMinutesNumber_ValueChanged" />
                </Grid>
              </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
          </toolkit:SettingsExpander>
          <!-- One card per action, built in code: each holds its key combination, set by pressing it. -->
          <toolkit:SettingsExpander x:Name="HotKeySection" IsExpanded="True" Header="Hotkeys"
                                    Description="They work in the game too." />
          <toolkit:SettingsExpander x:Name="AdvancedSection" Header="Advanced"
                                    Description="Open advanced configuration files and apply changes.">
            <toolkit:SettingsExpander.Items>
              <toolkit:SettingsCard x:Name="OpenConfigurationCard" Header="Open configuration files"
                                    Description="Open the folder containing advanced settings files. Change general settings on this screen.">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Library" /></toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="OpenConfigurationFolderButton" Content="Open folder"
                        Click="OpenConfigurationFolder_Click" />
              </toolkit:SettingsCard>
              <toolkit:SettingsCard x:Name="ApplyConfigurationCard" Header="Apply changes"
                                    Description="Check the edited settings files and restart the app. Any running operation must finish first.">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Refresh" /></toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="RestartForConfigurationButton" Content="Apply settings and restart"
                        Click="RestartForConfiguration_Click" />
              </toolkit:SettingsCard>
              <toolkit:SettingsCard x:Name="ResetConfigurationCard" Header="Reset advanced settings"
                                    Description="Keep a copy of the current files and restore the advanced defaults. Your saves and backups are not deleted.">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Undo" /></toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="ResetConfigurationButton" Content="Restore default settings"
                        Click="ResetConfiguration_Click" />
              </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
          </toolkit:SettingsExpander>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
