<Project DefaultTargets="Build">
  <Import Project="..\..\build\SaveBridge.props" />
  <PropertyGroup>
    <ExtensionOutput>$(BridgeOutputPath)\extensions</ExtensionOutput>
    <Classes>$(MSBuildProjectDirectory)\obj\$(Configuration)\classes</Classes>
    <RuntimeJar>$(ExtensionOutput)\pztools-extension-runtime.jar</RuntimeJar>
  </PropertyGroup>
  <ItemGroup><JavaSource Include="$(MSBuildProjectDirectory)\java\**\*.java" /></ItemGroup>
  <Target Name="Runtime" DependsOnTargets="ValidateBridgeToolchain">
    <MSBuild Projects="..\PzTools.GameExtensions.Java\PzTools.GameExtensions.Java.proj" Targets="Build"
             Properties="Configuration=$(Configuration);SaveBridgeDirectory=$(BridgeOutputPath);JdkPath=$(BridgeJdkPath)" />
  </Target>
  <!-- A deleted source changes no timestamp; the list does, so its classes are not left in the JAR. -->
  <Target Name="ListSources">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\obj\$(Configuration)\java-sources.txt" Lines="@(JavaSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="Build" DependsOnTargets="Runtime;ValidateBridgeToolchain;ListSources"
          Inputs="@(JavaSource);$(MSBuildProjectDirectory)\obj\$(Configuration)\java-sources.txt;$(RuntimeJar);$(MSBuildProjectFullPath);$(BridgeJdkPath)\release"
          Outputs="$(ExtensionOutput)\pztools-vehicle-drivetrain.jar">
    <RemoveDir Directories="$(Classes)" />
    <MakeDir Directories="$(Classes);$(ExtensionOutput)" />
    <Exec Command="&quot;$(BridgeJdkPath)\bin\javac.exe&quot; --release 25 -encoding UTF-8 -cp &quot;$(RuntimeJar)&quot; -d &quot;$(Classes)&quot; @(JavaSource->'&quot;%(FullPath)&quot;', ' ')" />
    <WriteLinesToFile File="$(Classes)\module.mf" Lines="Manifest-Version: 1.0;PzTools-Extension-Api: 3" Overwrite="true" />
    <Exec Command="&quot;$(BridgeJdkPath)\bin\jar.exe&quot; --create --date=2020-01-01T00:00:00Z --manifest &quot;$(Classes)\module.mf&quot; --file &quot;$(ExtensionOutput)\pztools-vehicle-drivetrain.jar&quot; -C &quot;$(Classes)&quot; pztools" />
  </Target>
</Project>
