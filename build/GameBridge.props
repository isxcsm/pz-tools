<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <GameBridgeRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</GameBridgeRepositoryRoot>
    <GameBridgeDirectory Condition="'$(GameBridgeDirectory)' == ''">$(GameBridgeRepositoryRoot)\artifacts\game-bridge\$(Configuration)</GameBridgeDirectory>
    <BridgeOutputPath>$([MSBuild]::NormalizePath('$(GameBridgeRepositoryRoot)', '$(GameBridgeDirectory)'))</BridgeOutputPath>
    <JdkPath Condition="'$(JdkPath)' == ''">$(JAVA_HOME)</JdkPath>
    <!-- A release of PZ Extension API (its own repository, beside this one), carried to help install it. -->
    <ExtensionApiRelease Condition="'$(ExtensionApiRelease)' == ''">$([System.IO.Path]::GetFullPath('$(GameBridgeRepositoryRoot)\..\pz-extension-api\out\release'))</ExtensionApiRelease>
  </PropertyGroup>
  <ItemGroup Condition="'$(JdkPath)' == ''">
    <_BridgeJdkRelease Include="$(GameBridgeRepositoryRoot)\artifacts\toolchains\jdk-25*\release" />
  </ItemGroup>
  <Target Name="ValidateBridgeToolchain">
    <PropertyGroup Condition="'$(JdkPath)' == '' and '@(_BridgeJdkRelease->Count())' == '1'">
      <JdkPath>@(_BridgeJdkRelease->'%(RootDir)%(Directory)')</JdkPath>
    </PropertyGroup>
    <Error Condition="'$(JdkPath)' == '' or !Exists('$(JdkPath)\bin\javac.exe')"
           Text="A Java 25 JDK is required. Set JAVA_HOME or pass -p:JdkPath=... (with multiple bundled JDKs, select one explicitly)." />
    <PropertyGroup>
      <BridgeJdkPath>$(JdkPath.TrimEnd('\/'))</BridgeJdkPath>
    </PropertyGroup>
  </Target>
</Project>
