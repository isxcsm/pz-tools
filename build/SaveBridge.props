<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <SaveBridgeRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</SaveBridgeRepositoryRoot>
    <SaveBridgeDirectory Condition="'$(SaveBridgeDirectory)' == ''">$(SaveBridgeRepositoryRoot)\artifacts\save-bridge\$(Configuration)</SaveBridgeDirectory>
    <BridgeOutputPath>$([MSBuild]::NormalizePath('$(SaveBridgeRepositoryRoot)', '$(SaveBridgeDirectory)'))</BridgeOutputPath>
    <JdkPath Condition="'$(JdkPath)' == ''">$(JAVA_HOME)</JdkPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(JdkPath)' == ''">
    <_BridgeJdkRelease Include="$(SaveBridgeRepositoryRoot)\artifacts\toolchains\jdk-25*\release" />
  </ItemGroup>
  <Target Name="ValidateBridgeToolchain">
    <PropertyGroup Condition="'$(JdkPath)' == '' and '@(_BridgeJdkRelease->Count())' == '1'">
      <JdkPath>@(_BridgeJdkRelease->'%(RootDir)%(Directory)')</JdkPath>
    </PropertyGroup>
    <Error Condition="'$(JdkPath)' == '' or !Exists('$(JdkPath)\bin\javac.exe')"
           Text="A Java 25 JDK is required. Set JAVA_HOME or pass -p:JdkPath=... (with multiple bundled JDKs, select one explicitly)." />
    <PropertyGroup>
      <BridgeJdkPath>$(JdkPath.TrimEnd('\/'))</BridgeJdkPath>
    </PropertyGroup>
  </Target>
</Project>
