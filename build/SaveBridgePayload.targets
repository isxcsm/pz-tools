<Project>
  <Import Project="SaveBridge.props" />
  <!-- Visual Studio skips a project its fast up-to-date check finds current, and that check knows nothing of the
       bridge's Java and native sources: a change to them alone left the old bridge in the F5 build. Compared with
       the jars they build, not with this project's assembly, which a bridge-only change does not rewrite. -->
  <ItemGroup>
    <!-- The agent jar is rebuilt from its own sources and from the extension runtime it compiles against. -->
    <UpToDateCheckInput Include="$(SaveBridgeRepositoryRoot)\src\PzTools.SaveBridge.Agent\**\*.java;
                                 $(SaveBridgeRepositoryRoot)\src\PzTools.SaveBridge.Agent\MANIFEST.MF;
                                 $(SaveBridgeRepositoryRoot)\src\PzTools.GameExtensions.Java\**\*.java" Set="SaveBridgeAgent" />
    <UpToDateCheckBuilt Include="$(BridgeOutputPath)\pztools-save-bridge.jar" Set="SaveBridgeAgent" />
    <UpToDateCheckInput Include="$(SaveBridgeRepositoryRoot)\src\PzTools.SaveBridge.Native\**\*.cpp" Set="SaveBridgeNative" />
    <UpToDateCheckBuilt Include="$(BridgeOutputPath)\pztools-attach-bootstrap.dll" Set="SaveBridgeNative" />
    <UpToDateCheckInput Include="$(SaveBridgeRepositoryRoot)\src\PzTools.GameExtensions.VehicleDrivetrain\**\*.java" Set="SaveBridgeDrivetrain" />
    <UpToDateCheckBuilt Include="$(BridgeOutputPath)\extensions\pztools-vehicle-drivetrain.jar" Set="SaveBridgeDrivetrain" />
  </ItemGroup>
  <Target Name="BuildSaveBridge" BeforeTargets="PrepareForBuild" DependsOnTargets="ValidateBridgeToolchain" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(SaveBridgeRepositoryRoot)\src\PzTools.SaveBridge.Agent\PzTools.SaveBridge.Agent.proj" Targets="Build"
             Properties="Configuration=$(Configuration);SaveBridgeDirectory=$(BridgeOutputPath);JdkPath=$(BridgeJdkPath)" />
  </Target>
  <!-- Evaluate the runtime files after generation, including on a clean checkout. -->
  <Target Name="IncludeSaveBridgePayload" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildSaveBridge"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <Content Include="$(BridgeOutputPath)\pztools-save-bridge.jar"
               Link="save-bridge\pztools-save-bridge.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$(BridgeOutputPath)\pztools-save-bootstrap.jar"
               Link="save-bridge\pztools-save-bootstrap.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$(BridgeOutputPath)\pztools-attach-bootstrap.dll"
               Link="save-bridge\pztools-attach-bootstrap.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <!-- Build outputs may also contain fixtures or retired modules. Ship only
           the runtime and provider built for the bundled catalogue. -->
      <_BridgeExtension Include="$(BridgeOutputPath)\extensions\pztools-extension-runtime.jar;$(BridgeOutputPath)\extensions\pztools-vehicle-drivetrain.jar" />
      <Content Include="@(_BridgeExtension)" Link="save-bridge\extensions\%(_BridgeExtension.Filename)%(_BridgeExtension.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$(SaveBridgeRepositoryRoot)\config\game-extensions\catalog.tsv" Link="save-bridge\extensions\catalog.tsv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$(SaveBridgeRepositoryRoot)\config\game-extensions\vehicle-drivetrain.toml" Link="save-bridge\extensions\vehicle-drivetrain.toml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <!-- Import libraries are for linking native programs, not running the bridge. -->
      <_BridgeRuntime Include="$(BridgeOutputPath)\runtime\**\*"
                      Exclude="$(BridgeOutputPath)\runtime\lib\jvm.lib" />
      <Content Include="@(_BridgeRuntime)"
               Link="save-bridge\runtime\%(_BridgeRuntime.RecursiveDir)%(_BridgeRuntime.Filename)%(_BridgeRuntime.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
