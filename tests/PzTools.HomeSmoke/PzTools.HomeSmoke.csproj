<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>ko-KR</DefaultLanguage>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <ProjectReference Include="../../src/PzTools.Process.Contracts/PzTools.Process.Contracts.csproj" />
    <Compile Include="../../src/PzTools.App/Localizer.cs" Link="Localizer.cs" />
    <PRIResource Include="../../src/PzTools.App/Strings/**/*.resw" Link="Strings/%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="../../src/PzTools.App/HomePage.xaml" Link="HomePage.xaml" />
    <Compile Include="../../src/PzTools.App/HomePage.xaml.cs" Link="HomePage.xaml.cs" />
    <Content Include="../../src/PzTools.App/App.xaml" Link="SmokeAppResources.xml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/PzTools.App/Assets/Brand/pztools-home.png"
             Link="Assets/Brand/pztools-home.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/PzTools.App/Assets/Navigation/home.svg"
             Link="Assets/Navigation/home.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/PzTools.App/Assets/Navigation/extensions.svg"
             Link="Assets/Navigation/extensions.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
