<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <ProjectReference Include="../../src/PzTools.App.Core/PzTools.App.Core.csproj" />
    <Compile Include="../../src/PzTools.App/ExtensionSettingsSection.cs" Link="ExtensionSettingsSection.cs" />
    <Compile Include="../../src/PzTools.App/SettingsExpanderLayout.cs" Link="SettingsExpanderLayout.cs" />
    <Compile Include="../../src/PzTools.App/Localizer.cs" Link="Localizer.cs" />
    <PRIResource Include="../../src/PzTools.App/Strings/**/*.resw" Link="Strings/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../src/PzTools.App/Assets/Navigation/extensions.svg"
             Link="Assets/Navigation/extensions.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
